<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <title>Email Verification</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style type="text/css">
    body {
      background-color: #e9ecef;
      margin: 0;
      padding: 0;
      font-family: 'Source Sans Pro', Helvetica, Arial, sans-serif;
    }

    .container {
      max-width: 600px;
      margin: auto;
      background: #ffffff;
      padding: 24px;
      border-top: 3px solid #d4dadf;
    }

    .title {
      font-size: 32px;
      font-weight: 700;
      margin: 0;
    }

    .otp {
      font-size: 28px;
      font-weight: 700;
      text-align: center;
      letter-spacing: 6px;
      margin: 20px 0;
      color: #1a82e2;
    }

    .btn {
      display: inline-block;
      padding: 15px 20px;
      background: #1a82e2;
      color: #ffffff;
      text-decoration: none;
      border-radius: 6px;
      font-size: 16px;
    }

    .footer {
      margin-top: 20px;
      font-size: 14px;
      color: #666;
    }
  </style>
</head>

<body>

  <div class="container">

    <!-- Title -->
    <h1 class="title">Confirm Your Email Address</h1>

    <!-- Message -->
    <p>Use the OTP code below to verify your email address:</p>

    <!-- OTP -->
    <div class="otp">
      {{OTPCode}}
    </div>

    <!-- Button style (optional display same code) -->
    <div style="text-align:center; margin: 20px 0;">
      <a class="btn" href="#">
        {{OTPCode}}
      </a>
    </div>

    <!-- Footer -->
    <p class="footer">
      Cheers,<br />
      Fekry Bahaa
    </p>

  </div>

</body>
</html>